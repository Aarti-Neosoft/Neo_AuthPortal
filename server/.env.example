# ==========================================
# Server & Environment Configuration
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# MongoDB Configuration
# ==========================================
# Primary local or MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/neosoft_auth_db
# Set to 'true' to always use MongoMemoryServer in-memory DB (no local mongo daemon needed)
USE_MEMORY_DB=false

# ==========================================
# Security & JWT Secrets
# ==========================================
JWT_SECRET=neosoft_super_secure_jwt_secret_token_key_2026_change_in_production
JWT_EXPIRES_IN=7d
OTP_HASH_SECRET=neosoft_otp_hmac_secret_salt_key_2026

# ==========================================
# Email Delivery (Nodemailer / SMTP)
# (Leave empty to use built-in Development Mock Delivery mode)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Neosoft Auth App" <noreply@neosoft.com>

# ==========================================
# SMS Delivery (Twilio - Optional)
# (Leave empty to use built-in Development Mock SMS Delivery mode)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
